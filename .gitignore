# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Environment variables (NEVER commit secrets)
.env
*.env.local

# ChromaDB / uploaded data (don't commit user data or vector db)
backend/data/uploads/*
backend/data/chroma_db/*
!backend/data/uploads/.gitkeep
!backend/data/chroma_db/.gitkeep

# SQLite
*.db
*.sqlite3

# Node / Next.js
node_modules/
.next/
out/
.vercel/

# OS / Editor
.DS_Store
.vscode/*
!.vscode/extensions.json
*.log
