# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual ".env" file to GitHub.
#
# This app stores all persistent data in Supabase (Postgres + Storage),
# not on local disk. Use the SAME Supabase project for local dev and for
# your deployed backend, so behavior matches in both places.
# Create a free project at https://supabase.com

# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Used to sign JWT auth tokens - use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_string

# Secret code someone must provide to register as an admin (pick your own)
ADMIN_SIGNUP_CODE=change_this_to_a_secret_code

# --- Supabase ---
# Database connection string:
# Supabase dashboard -> Project Settings -> Database -> Connection string
# Use the "Transaction" pooler URI (port 6543) - it's the one designed for
# apps like this. It looks like:
#   postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase dashboard -> Project Settings -> Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> service_role (secret!)
# This key bypasses Row Level Security - never expose it to the frontend,
# it's backend-only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Name of the Storage bucket used to hold PDFs (created automatically on
# first run if it doesn't exist)
SUPABASE_STORAGE_BUCKET=documents
