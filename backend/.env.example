# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual ".env" file to GitHub.

# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Used to sign JWT auth tokens - use any long random string
JWT_SECRET_KEY=change_this_to_a_long_random_string

# Secret code someone must provide to register as an admin (pick your own)
ADMIN_SIGNUP_CODE=change_this_to_a_secret_code

# Local SQLite database path (default is fine for dev)
DATABASE_URL=sqlite:///./data/app.db

# Where uploaded PDFs and the vector DB are stored
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma_db
